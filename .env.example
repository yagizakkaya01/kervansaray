# ============================================================
# Kervansaray - ortam degiskenleri sablonu
# Kopyala:  cp .env.example .env   ve degerleri doldur.
# .env dosyasi git'e ASLA commit'lenmez (bkz. .gitignore).
# ============================================================

# --- Sunucu ---
HOST=0.0.0.0
PORT=8000

# --- Public Demo / Operator Modu (Fail-closed) ---
# false: Public demo modu (kesinlikle read-only; POST /events ve /api/review kilitli)
# true: Operator / yerel gelistirme modu (onay kuyrugu ve ingest acik)
ENABLE_OPERATOR_ROUTES=false

# --- Veritabani (Postgres; sadece localhost'a bagli) ---
POSTGRES_PASSWORD=kervansaray
DATABASE_URL=postgresql://kervansaray:kervansaray@localhost:5432/kervansaray

# --- LLM saglayicilari (bulut API; brief S10) ---
LLM_PROVIDER_ORDER=nvidia,gemini

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=60

# --- Loglama ---
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=logs/app.log

# --- Gozlemlenebilirlik ---
# Public demoda ic metrikleri (hata/gecikme/kota) disari acmamak icin false onerilir
METRICS_ENABLED=false
METRICS_PATH=/metrics
