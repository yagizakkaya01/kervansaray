# ============================================================
# Kervansaray - ortam degiskenleri sablonu
# Kopyala:  cp .env.example .env   ve degerleri doldur.
# .env dosyasi git'e ASLA commit'lenmez (bkz. .gitignore).
# ============================================================

# --- Sunucu ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- Veritabani (Postgres + pgvector; sadece localhost'a bagli) ---
DATABASE_URL=postgresql://kervansaray:kervansaray@localhost:5432/kervansaray

# --- LLM saglayicilari (bulut API; brief S10) ---
# Fallback sirasi: soldan saga denenir, hata alaninca sonraki saglayiciya gecilir.
LLM_PROVIDER_ORDER=groq,gemini,openai

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=60

# --- Loglama ---
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=logs/app.log

# --- Gozlemlenebilirlik ---
METRICS_ENABLED=true
METRICS_PATH=/metrics
